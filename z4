fetch('https://jsonplaceholder.typicode.com/todos')
  .then(function(response) {
    return response.json();
  })
  .then(function(compl) {
    let result = [];
    for (let i = 0; i < compl.length; i++) {
      let tf = compl[i];
      if (tf.completed == false) {
        let tf1 = {
          id: tf.id ,
          completed: tf.completed
        };
        result.push(tf1);
      }
    }
    console.log(result);
  });
