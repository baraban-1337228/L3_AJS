function mySortFunction(data) {
  setTimeout(function() {
    data.sort(function(a, b) {
      return b.title.length - a.title.length;
    });
    let result = [];
    for (let i = 0; i < data.length; i++) {
      let currentPost = data[i];
      let postInfo = {
        id: currentPost.id,
        titleLength: currentPost.title.length,
        title: currentPost.title
      };
      result.push(postInfo);
    }
    console.log(result);
  }, 0);
}
fetch('https://jsonplaceholder.typicode.com/posts')
  .then(function(res) {
    return res.json();
  })
  .then(function(json) {
    mySortFunction(json);
  });
